// Edwyz WA data model. Every tenant-owned table carries tenantId; queries must always filter by it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  agent
}

enum OnboardingStatus {
  not_started
  in_progress
  live
  failed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  read
  failed
}

enum TemplateStatus {
  draft
  pending
  approved
  rejected
  paused
  disabled
  // Meta flagged it for low quality (migration 0011, docs/SPEND-CONTROLS-SPEC.md 6.3): marketing broadcasts and assistants may not use it.
  flagged
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  completed
  paused
  canceled
  failed
}

enum RecipientStatus {
  pending
  queued
  sent
  delivered
  read
  failed
  skipped
}

enum TenantStatus {
  active
  suspended
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  expired
}

enum InvoiceStatus {
  issued
  paid
  void
}

enum AutomationType {
  welcome
  away
  keyword
}

enum JobStatus {
  queued
  running
  done
  failed
}

model Tenant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  onboardingStatus OnboardingStatus @default(not_started)
  walletPaise      Int              @default(0)
  status           TenantStatus     @default(active)
  suspendedReason  String?
  deletedAt        DateTime?
  trialEndsAt      DateTime?
  // Comped accounts (staff, partners) skip the paywall. Set only by a platform admin.
  billingExempt    Boolean          @default(false)
  createdAt        DateTime         @default(now())

  memberships    Membership[]
  invites        Invite[]
  wabas          Waba[]
  subscription   Subscription?
  billingProfile BillingProfile?
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  disabledAt         DateTime?
  emailVerifiedAt    DateTime?
  totpCiphertext     String?
  totpIv             String?
  totpTag            String?
  totpEnabledAt      DateTime?
  totpRecoveryHashes String[]
  createdAt          DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  emailTokens EmailToken[]
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  tenantId         String?
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Waba {
  id         String   @id @default(cuid())
  tenantId   String
  wabaId     String   @unique
  name       String?
  businessId String?
  createdAt  DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumbers PhoneNumber[]
  templates    Template[]

  @@index([tenantId])
}

model PhoneNumber {
  id                 String    @id @default(cuid())
  tenantId           String
  wabaRefId          String
  phoneNumberId      String    @unique
  displayPhone       String
  verifiedName       String?
  qualityRating      String?
  messagingLimitTier String?
  nameStatus         String?
  status             String    @default("pending")
  registeredAt       DateTime?
  createdAt          DateTime  @default(now())

  waba          Waba           @relation(fields: [wabaRefId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  broadcasts    Broadcast[]

  @@index([tenantId])
}

model AccessToken {
  id              String    @id @default(cuid())
  tenantId        String
  wabaRefId       String?
  tokenCiphertext String
  iv              String
  authTag         String
  keyVersion      Int       @default(1)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

model OnboardingLog {
  id        String   @id @default(cuid())
  tenantId  String
  step      String
  status    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([tenantId, step])
}

model Contact {
  id          String    @id @default(cuid())
  tenantId    String
  phone       String?
  name        String?
  attributes  Json      @default("{}")
  tags        String[]
  optIn       Boolean   @default(false)
  optInSource String?
  optInAt     DateTime?
  optedOutAt  DateTime?
  bsuid       String?
  username    String?
  waId        String?
  ownerUserId String?
  leadStage   String?
  createdAt   DateTime  @default(now())

  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([tenantId, phone])
  @@unique([tenantId, bsuid])
  @@index([tenantId])
}

model Conversation {
  id                String    @id @default(cuid())
  tenantId          String
  phoneNumberId     String
  contactId         String
  assignedToId      String?
  status            String    @default("open")
  tags              String[]
  unreadCount       Int       @default(0)
  lastMessageAt     DateTime  @default(now())
  lastInboundAt     DateTime?
  // Click-to-WhatsApp referral from the first inbound message: { sourceType, sourceId, sourceUrl, headline, ctwaClid }
  referral          Json?
  assignedAt        DateTime?
  statusChangedAt   DateTime?
  teamId            String?
  lastAgentReplyAt  DateTime?
  firstAgentReplyAt DateTime?
  createdAt         DateTime  @default(now())

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages    Message[]
  notes       Note[]

  @@unique([phoneNumberId, contactId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  wamid          String?          @unique
  direction      MessageDirection
  type           String           @default("text")
  body           String?
  mediaUrl       String?
  mediaMime      String?
  templateName   String?
  status         MessageStatus
  statusTimeline Json             @default("[]")
  errorCode      String?
  sentByUserId   String?
  createdAt      DateTime         @default(now())

  // Spend controls (migration 0009, docs/SPEND-CONTROLS-SPEC.md 3.3 and 4.9). Money is integer minor units of the rate card currency.
  // origin: human | api | mcp | assistant | broadcast | automation | chatbot | ai_reply | lead_sequence | commerce | consent | approval | admin_test | system_notify | eddy | unknown
  origin           String?
  pricingCategory  String?
  estCostMinor     BigInt?
  costMinor        BigInt?
  billable         Boolean?
  pricingType      String?
  spendDay         DateTime? @db.Date
  // reserved | settled | released (CHECK in SQL only, added NOT VALID in 0009 and validated in 0010)
  spendState       String?
  reservationId    String?
  pricingSettledAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  // SQL only (0010, CREATE INDEX CONCURRENTLY): partial indexes Message_spend_open_idx and Message_pricing_unsettled_idx.
}

model Note {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
}

model QuickReply {
  id       String @id @default(cuid())
  tenantId String
  shortcut String
  body     String

  @@unique([tenantId, shortcut])
}

model Template {
  id              String         @id @default(cuid())
  tenantId        String
  wabaRefId       String
  name            String
  language        String
  category        String
  status          TemplateStatus @default(draft)
  components      Json
  metaTemplateId  String?
  rejectionReason String?
  // Header media uploaded to Meta for the template: { type, handle, key, mime }
  headerMedia     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  waba       Waba        @relation(fields: [wabaRefId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@unique([tenantId, wabaRefId, name, language])
  @@index([tenantId])
}

model Broadcast {
  id                 String          @id @default(cuid())
  tenantId           String
  phoneNumberId      String
  templateId         String
  name               String
  status             BroadcastStatus @default(draft)
  segmentTags        String[]
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  estimatedCostPaise Int?
  // Days to keep retrying recipients whose send failed on Meta's per-user marketing cap (0 = never retry).
  retryDays          Int             @default(0)
  // { segmentId?, filter? } audience stack; variableMap: { "1": { source: "attribute"|"field"|"static", key, fallback? } }
  audienceFilter     Json?
  variableMap        Json?
  missingValuePolicy String          @default("skip")
  createdByUserId    String?
  createdAt          DateTime        @default(now())

  phoneNumber PhoneNumber          @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  template    Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients  BroadcastRecipient[]

  @@index([tenantId, status])
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  tenantId    String
  broadcastId String
  contactId   String
  status      RecipientStatus @default(pending)
  wamid       String?
  messageId   String?         @unique
  errorCode   String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  attempts    Int             @default(0)
  retryAfter  DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([tenantId, broadcastId, status])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  tenantId       String?
  wabaId         String?
  phoneNumberId  String?
  payload        Json
  signatureValid Boolean   @default(true)
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())

  @@index([processedAt, receivedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  amountPaise Int
  kind        String
  reference   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Postgres-backed job queue (FOR UPDATE SKIP LOCKED). The interface in src/lib/queue.ts is shaped so BullMQ can replace it later.
model Job {
  id          String    @id @default(cuid())
  queue       String
  payload     Json
  status      JobStatus @default(queued)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([queue, status, runAt])
}

// ---------- Billing and paywall (Razorpay) ----------

model Plan {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  description           String?
  // Prices are set by the platform admin. There are no built-in prices.
  pricePaise            Int
  currency              String   @default("INR")
  intervalMonths        Int      @default(1)
  seatLimit             Int?
  contactLimit          Int?
  monthlyBroadcastLimit Int?
  aiCreditsMonthly      Int?
  adAccountLimit        Int?
  scheduledPostLimit    Int?
  connectedChannelLimit Int?
  features              Json     @default("{}")
  razorpayPlanId        String?
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  planId                 String
  status                 SubscriptionStatus
  razorpaySubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  pastDueSince           DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

model BillingProfile {
  tenantId     String   @id
  legalName    String
  gstin        String?
  addressLine  String
  state        String
  pincode      String?
  billingEmail String
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  number            String        @unique
  status            InvoiceStatus @default(issued)
  planName          String
  amountPaise       Int
  gstRateBps        Int
  gstPaise          Int
  totalPaise        Int
  currency          String        @default("INR")
  customerName      String?
  customerGstin     String?
  customerAddress   String?
  razorpayPaymentId String?       @unique
  periodStart       DateTime?
  periodEnd         DateTime?
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?

  @@index([tenantId, issuedAt])
}

// Gateway webhook log. eventId makes processing idempotent.
model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())
}

// Editable platform configuration (trial length, GST rate, seller details, grace days). Values are JSON.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Automation, API access and outbound webhooks ----------

model AutomationRule {
  id              String         @id @default(cuid())
  tenantId        String
  phoneNumberId   String?
  type            AutomationType
  name            String
  enabled         Boolean        @default(true)
  keywords        String[]
  matchMode       String         @default("contains")
  replyText       String
  // Away hours: { timezone, days: [0-6], start: "HH:MM", end: "HH:MM" }
  schedule        Json?
  cooldownMinutes Int            @default(720)
  // Rules v2: version 2 rows use trigger, filters and actions below instead of keywords and replyText.
  version         Int            @default(1)
  priority        Int            @default(0)
  trigger         Json?
  filters         Json?
  actions         Json?
  stopAfterMatch  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, enabled])
}

// One row per automatic reply, used to enforce cooldowns and stop loops.
model AutomationRun {
  id             String   @id @default(cuid())
  tenantId       String
  ruleId         String
  conversationId String
  createdAt      DateTime @default(now())

  @@index([ruleId, conversationId, createdAt])
}

model ApiKey {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  prefix          String    @unique
  keyHash         String    @unique
  scopes          String[]
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

model WebhookEndpoint {
  id               String   @id @default(cuid())
  tenantId         String
  url              String
  secretCiphertext String
  iv               String
  authTag          String
  events           String[]
  enabled          Boolean  @default(true)
  failureCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  tenantId   String
  endpointId String
  event      String
  payload    Json
  status     String   @default("pending")
  attempts   Int      @default(0)
  lastStatus Int?
  lastError  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, endpointId, createdAt])
}

// Daily counters for reports and the platform dashboard. scope is a tenantId or "platform"; day is YYYY-MM-DD.
model DailyMetric {
  id    String @id @default(cuid())
  scope String
  day   String
  key   String
  value Int

  @@unique([scope, day, key])
}

// One-time tokens sent by email: address verification and password reset. Only the hash is stored.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum ChatbotStatus {
  draft
  published
  archived
}

enum ChatbotSessionStatus {
  active
  waiting
  completed
  handed_off
  expired
}

// A conversation flow built in the UI. `flow` is the editable draft, `publishedFlow` is what runs.
// Shape of both: see docs/phase2-contracts.md (nodes + edges, validated by src/lib/chatbots/flow.ts).
model Chatbot {
  id              String        @id @default(cuid())
  tenantId        String
  phoneNumberId   String?
  name            String
  status          ChatbotStatus @default(draft)
  // keyword | first_message | any_message | manual
  triggerType     String        @default("keyword")
  triggerKeywords String[]
  flow            Json
  publishedFlow   Json?
  version         Int           @default(1)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions ChatbotSession[]

  @@index([tenantId, status])
}

model ChatbotSession {
  id             String               @id @default(cuid())
  tenantId       String
  chatbotId      String
  conversationId String
  contactId      String
  status         ChatbotSessionStatus @default(active)
  currentNodeId  String?
  // Set while the bot waits for the customer's answer to an ask node.
  waitingNodeId  String?
  // Set while a delay node is pending; the worker resumes sessions whose wakeAt has passed.
  wakeAt         DateTime?
  variables      Json                 @default("{}")
  startedAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  endedAt        DateTime?

  chatbot Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, status])
  @@index([status, wakeAt])
}

// Per-workspace assignment settings (one row per tenant).
model RoutingConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  autoAssign      Boolean  @default(false)
  // round_robin | least_busy
  mode            String   @default("round_robin")
  timezone        String   @default("Asia/Kolkata")
  // { days: [0-6], start: "HH:MM", end: "HH:MM" } or null for always on
  workingHours    Json?
  maxOpenPerAgent Int?
  fallbackUserId  String?
  updatedAt       DateTime @updatedAt
}

model AgentAvailability {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  available      Boolean   @default(true)
  maxOpen        Int?
  lastAssignedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, available])
}

// ---------------------------------------------------------------------------
// Growth platform and Phase 3 (see docs/PRODUCT-SPEC-GROWTH.md, docs/phase3-contracts.md)
// Statuses are plain strings validated in code. Money is integer minor units (paise).
// ---------------------------------------------------------------------------

model MetaConnection {
  id                String    @id @default(cuid())
  tenantId          String
  metaUserId        String
  businessId        String?
  scopes            String[]
  // Encrypted with src/lib/crypto. Never returned by any API.
  tokenEnc          String
  tokenExpiresAt    DateTime?
  // active | expiring | expired | revoked | error
  status            String    @default("active")
  connectedByUserId String
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assets MetaAsset[]

  @@unique([tenantId, metaUserId])
  @@index([tenantId, status])
}

model MetaAsset {
  id           String   @id @default(cuid())
  tenantId     String
  connectionId String
  // page | instagram | ad_account | dataset | catalog | threads
  type         String
  externalId   String
  name         String?
  // Page access tokens etc., encrypted.
  tokenEnc     String?
  status       String   @default("active")
  meta         Json     @default("{}")
  // Spend controls (0009): a Meta sandbox ad account. Wall (a) is skipped and its ledger rows are flagged.
  sandbox      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, externalId])
  @@index([tenantId, type])
}

model Brand {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  websiteUrl        String?
  logoUrl           String?
  colors            String[]
  fonts             String[]
  tone              String?
  bannedWords       String[]
  industry          String?
  // none | housing | employment | credit | social_issues
  specialAdCategory String   @default("none")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  briefs CreativeBrief[]

  @@index([tenantId])
}

model CreativeBrief {
  id              String   @id @default(cuid())
  tenantId        String
  brandId         String
  // leads | messages | traffic | awareness
  goal            String
  offer           String
  // draft | researching | angles_ready | generating | ready | approved | archived
  status          String   @default("draft")
  researchSummary Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand  Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  angles CreativeAngle[]
  assets CreativeAsset[]

  @@index([tenantId, status])
}

model CreativeAngle {
  id        String  @id @default(cuid())
  tenantId  String
  briefId   String
  hook      String
  audience  String
  cta       String
  rationale String?
  selected  Boolean @default(false)

  brief  CreativeBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  assets CreativeAsset[]

  @@index([tenantId, briefId])
}

model CreativeAsset {
  id          String   @id @default(cuid())
  tenantId    String
  briefId     String
  angleId     String?
  // image | video | copy
  kind        String
  // feed | story | reel | square | none
  placement   String   @default("feed")
  headline    String?
  body        String?
  storageKey  String?
  provider    String?
  aiGenerated Boolean  @default(true)
  creditCost  Int      @default(0)
  // pending | ready | failed | approved | rejected
  status      String   @default("pending")
  // { result: pass|warn|block, findings: [...] }
  policyCheck Json?
  createdAt   DateTime @default(now())

  brief CreativeBrief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  angle CreativeAngle? @relation(fields: [angleId], references: [id], onDelete: SetNull)

  @@index([tenantId, briefId])
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  tenantId    String
  // creative_asset | creative_brief | ad_campaign | scheduled_post | optimizer_proposal
  subjectType String
  subjectId   String
  tokenHash   String    @unique
  // pending | approved | changes_requested | rejected | expired
  status      String    @default("pending")
  comment     String?
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
}

model AdCampaign {
  id                String    @id @default(cuid())
  tenantId          String
  adAccountAssetId  String
  metaCampaignId    String?
  name              String
  // lead_generation | click_to_whatsapp | traffic | boost_post
  template          String
