  language        String    @default("en")
  title           String?
  status          String    @default("active")
  closedReason    String?
  turnCount       Int       @default(0)
  nextSeq         Int       @default(0)
  lastInputTokens Int       @default(0)
  lastCallAt      DateTime?
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())
  messages        EddyMessage[]
  turns           EddyTurn[]
  actions         ActionRecord[]

  @@index([tenantId, userId, lastMessageAt])
  @@index([lastMessageAt])
  // SQL only: partial unique EddyConversation_one_active_key (tenantId, userId) WHERE status = 'active'
}

model EddyMessage {
  id              String   @id @default(cuid())
  conversationId  String
  tenantId        String
  turnId          String?
  seq             Int
  role            String
  kind            String
  content         Json     @db.Json // JSON, not JSONB: keeps the blocks byte-exact for the append-only replay (EDDY 5.8)
  display         Json?
  contactIds      String[] @default([])
  conversationIds String[] @default([])
  createdAt       DateTime @default(now())
  conversation    EddyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([tenantId, createdAt])
  // SQL only: GIN index on contactIds and the UPDATE trigger (edwyz_append_only): rows are never edited, only deleted.
}

model EddyTurn {
  id               String    @id @default(cuid())
  conversationId   String?
  tenantId         String
  userId           String?
  status           String    @default("running")
  model            String
  language         String
  rounds           Int       @default(0)
  toolCalls        Int       @default(0)
  cardsCreated     Int       @default(0)
  inputTokens      Int       @default(0)
  cacheWriteTokens Int       @default(0)
  cacheReadTokens  Int       @default(0)
  outputTokens     Int       @default(0)
  costMicroUsd     BigInt    @default(0)
  platformMicroUsd BigInt    @default(0) // (critic) 5.10
  creditsCharged   Int       @default(0)
  stopReason       String?
  refusalCategory  String?
  errorCode        String?
  requestIds       String[]  @default([])
  firstTokenMs     Int?
  durationMs       Int?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  conversation     EddyConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, startedAt])
  @@index([tenantId, userId, startedAt])
  // SQL only: partial unique EddyTurn_one_running_key (conversationId) WHERE status = 'running'
}

model ActionRecord {
  id                 String    @id @default(cuid())
  tenantId           String
  userId             String
  via                String
  principalId        String
  conversationId     String?
  turnId             String?
  toolUseId          String?
  action             String
  risk               String
  status             String
  args               Json
  argsHash           String
  preview            Json?
  previewHash        String?
  nonceHash          String?
  expiresAt          DateTime?
  decidedAt          DateTime?
  result             Json?
  error              String?
  undo               Json?
  undoUntil          DateTime?
  undoneAt           DateTime?
  spendPot           String?
  spendCorrelationId String?
  spendApprovalId    String?
  supersededById     String?
  contactIds         String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  conversation       EddyConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@index([conversationId, createdAt])
  @@index([status, expiresAt])
  @@index([tenantId, decidedAt])
  @@index([spendApprovalId])
  // SQL only: GIN index on contactIds.
}

model ActionInvocation {
  id                 String   @id @default(cuid())
  tenantId           String
  userId             String?
  via                String
  principalId        String
  opId               String
  action             String
  risk               String
  stage              String
  outcome            String
  code               String?
  argsHash           String
  argsRedacted       Json     @default("{}")
  resultRef          String?
  conversationId     String?
  turnId             String?
  actionRecordId     String?
  spendCorrelationId String?
  piiItems           Int?
  durationMs         Int?
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([opId])
  // SQL only: append-only guard; the one allowed UPDATE sets userId to NULL (anonymisation) and changes nothing else.
}

model Notice {
  id              String    @id @default(cuid())
  tenantId        String
  kind            String
  severity        String
  audienceUserId  String?
  audienceMinRole Role      @default(agent)
  dedupeKey       String
  subjectType     String?
  subjectId       String?
  payload         Json      @default("{}")
  actions         Json      @default("[]")
  count           Int       @default(1)
  source          String    @default("eddy")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  expiresAt       DateTime
  resolvedAt      DateTime?
  receipts        NoticeReceipt[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, resolvedAt, createdAt])
  @@index([expiresAt])
}

model NoticeReceipt {
  noticeId    String
  userId      String
  tenantId    String
  seenAt      DateTime?
  dismissedAt DateTime?
  toastedAt   DateTime?
  notice      Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([tenantId, userId])
}

model NoticeScanState {
  tenantId  String
  scanner   String
  cursor    Json
  updatedAt DateTime @default(now()) @updatedAt

  @@id([tenantId, scanner])
}
