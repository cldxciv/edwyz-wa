model SpendLedger {
  id                 String   @id @default(cuid())
  seq                BigInt   @unique @default(autoincrement())
  tenantId           String
  pot                String   // ads | messaging | ai | none
  action             String
  phase              String   // requested | applied | failed | unconfirmed | refused | shadow | reconciled | info
  actorType          String   // user | assistant | system | breaker | platform_admin | api | external (critic)
  actorId            String?
  assistantKey       String?
  autonomyLevel      Int?     @db.SmallInt
  targetType         String?
  targetId           String?
  metaObjectId       String?
  currency           String?
  amountMinor        BigInt?
  forecastTodayMinor BigInt?
  forecastMonthMinor BigInt?
  before             Json?
  after              Json?
  snapshot           Json?
  reason             String
  reasonCodes        String[] @default([])
  approvalId         String?
  undo               Json?
  correlationId      String
  idempotencyKey     String?
  observe            Boolean  @default(false)
  sandbox            Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, seq])
  @@index([targetId, action, createdAt])
  @@index([correlationId])
  // SQL only: append-only triggers (UPDATE, DELETE and TRUNCATE refused; erasure purges one workspace with the edwyz.purge
  // GUC set to '<table>:<tenantId>') and the partial uniques SpendLedger_idem_key (tenantId, idempotencyKey, phase) WHERE
  // idempotencyKey IS NOT NULL, SpendLedger_one_outcome_key (tenantId, correlationId) WHERE phase IN (applied, failed,
  // unconfirmed, refused) and SpendLedger_one_reconciled_key (tenantId, correlationId) WHERE phase = 'reconciled'.
}

