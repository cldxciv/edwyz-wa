# Secrets come from the environment only. Never commit real values.

# Public site URL (used for links and the data-deletion callback response)
SITE_URL=https://wa.edwyz.com

# From Meta for Developers > App "Edwyz API" > App settings > Basic
META_APP_SECRET=

# Any long random string. Enter the same value as "Verify token" when you set the webhook in the Meta dashboard.
META_VERIFY_TOKEN=

# Embedded Signup configuration id (created after the domain is live)
META_ES_CONFIG_ID=

# Signs the CSRF state used by the signup flow. Any long random string.
STATE_SECRET=

# Where raw webhook events and deletion requests are written until the database exists
DATA_DIR=./data

# Postgres connection string
DATABASE_URL=

# Signs access tokens (JWT HS256). Any long random string.
SESSION_SECRET=

# 32 random bytes, base64. Encrypts Meta access tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# Comma-separated emails allowed into the platform admin page
PLATFORM_ADMIN_EMAILS=

# Meta app id (App settings > Basic). Public; sent to the browser for the Embedded Signup SDK.
META_APP_ID=

# Shared secret for POST /api/internal/tick (header x-worker-secret). Any long random string.
WORKER_SECRET=

# Outgoing email (SMTP, STARTTLS on 587). With SMTP_USER unset nothing is sent and only a short log line is written.
SMTP_HOST=mail.edwyz.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Edwyz WA <noreply@edwyz.com>"

# Razorpay (Subscriptions). Key id and secret from Dashboard > Account & Settings > API keys (use test keys until launch).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set on the webhook in Dashboard > Webhooks; separate from the key secret.
RAZORPAY_WEBHOOK_SECRET=

# Facebook Login for Business configuration id for Connect (Pages, Instagram, ads). Create it with the scopes in src/lib/meta-connect/scopes.ts.
# Add https://wa.edwyz.com/api/meta-connect/callback to Valid OAuth redirect URIs.
META_LOGIN_CONFIG_ID=

# Content calendar: HMAC secret for the short-lived public media URLs Meta fetches (falls back to STATE_SECRET when empty).
CONTENT_MEDIA_SECRET=

# Creative Studio: AI model comes from AI_MODEL/ANTHROPIC_API_KEY. CREATIVE_IMAGE_PROVIDER selects the image provider (default "placeholder").
CREATIVE_IMAGE_PROVIDER=placeholder
# HMAC secret for signed public creative asset URLs (falls back to STATE_SECRET when empty).
CREATIVE_MEDIA_SECRET=

# Platform ceiling for any workspace daily ad budget cap, in minor units (campaign-launcher). Unset = only the workspace cap applies.
MAX_DAILY_BUDGET_MINOR=

# AI agent cost guards (ai-mcp). Monthly credits for workspaces whose plan sets no AI credit limit (default 200, never unlimited).
AI_DEFAULT_MONTHLY_CREDITS=200
# Comma-separated Claude model ids a workspace may choose for its AI agent. Unset = only the default model (AI_MODEL).
AI_ALLOWED_MODELS=
# Workspace-wide cap on AI replies per hour (default 60).
AI_MAX_REPLIES_PER_HOUR=60

# Tenant MCP sending limits (ai-mcp). Confirmed sends per API key per hour and per contact per 24 hours.
MCP_MAX_SENDS_PER_KEY_HOUR=20
MCP_MAX_SENDS_PER_RECIPIENT_DAY=3
# HMAC secret for MCP confirm tokens (falls back to STATE_SECRET when empty; sending is refused if neither is set).
MCP_CONFIRM_SECRET=

# Optional guard for scripts/check-env.mjs and the startup report: number of web (not worker) instances you run. Must stay 1 until the shared rate limiter exists (docs/ops.md).
# WEB_INSTANCES=1

# Creative Studio HTTP image provider (CREATIVE_IMAGE_PROVIDER=http). Contract: docs/creative-image-provider.md. Both are required; the key is a secret.
CREATIVE_IMAGE_URL=
CREATIVE_IMAGE_KEY=

# Email verification gate (platform-saas). Unverified users can read and change settings but cannot send, import, create API keys or connect Meta.
# true or false forces it. When empty or unset the gate is on only if SMTP_USER is set (so a workspace is never stuck read-only because no mail can be sent).
EMAIL_VERIFICATION_REQUIRED=

# Worker daemon (pm2 app edwyz-wa-worker): milliseconds between polls when idle (default 2000, minimum 250).
WORKER_INTERVAL_MS=2000

# Android app (Trusted Web Activity, docs/PLAY-STORE.md). Both optional. /.well-known/assetlinks.json is served only when at least one
# valid fingerprint is set, and answers 404 otherwise. ANDROID_PACKAGE defaults to com.edwyz.wa.
# ANDROID_ASSETLINKS_SHA256: comma-separated SHA-256 signing certificate fingerprints, 32 colon-separated hex bytes each (AB:CD:...),
# for BOTH the upload key (keytool -list -v) and Google Play's app signing key (Play Console > Test and release > Setup > App signing).
ANDROID_PACKAGE=
ANDROID_ASSETLINKS_SHA256=
