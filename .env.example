# Secrets come from the environment only. Never commit real values.

# Public site URL (used for links and the data-deletion callback response)
SITE_URL=https://wa.edwyz.com

# From Meta for Developers > App "Edwyz API" > App settings > Basic
META_APP_SECRET=

# Any long random string. Enter the same value as "Verify token" when you set the webhook in the Meta dashboard.
META_VERIFY_TOKEN=

# Embedded Signup configuration id (created after the domain is live)
META_ES_CONFIG_ID=

# Signs the CSRF state used by the signup flow. Any long random string.
STATE_SECRET=

# Where raw webhook events and deletion requests are written until the database exists
DATA_DIR=./data

# Postgres connection string
DATABASE_URL=

# Signs access tokens (JWT HS256). Any long random string.
SESSION_SECRET=

# 32 random bytes, base64. Encrypts Meta access tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# Comma-separated emails allowed into the platform admin page
PLATFORM_ADMIN_EMAILS=

# Meta app id (App settings > Basic). Public; sent to the browser for the Embedded Signup SDK.
META_APP_ID=

# Shared secret for POST /api/internal/tick (header x-worker-secret). Any long random string.
WORKER_SECRET=

# Outgoing email (SMTP, STARTTLS on 587). With SMTP_USER unset nothing is sent and only a short log line is written.
# Local relay without a login: SMTP_HOST=127.0.0.1, SMTP_PORT=25, SMTP_USER=<the from address>, SMTP_PASS empty and
# SMTP_TLS_SERVERNAME=mail.edwyz.com (the name on the mail server's certificate, checked during STARTTLS).
# SMTP_PORT=465 switches to implicit TLS (encrypted from the first byte) instead of STARTTLS.
SMTP_HOST=mail.edwyz.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS_SERVERNAME=
EMAIL_FROM="Edwyz WA <noreply@edwyz.com>"

# Razorpay (Subscriptions). Key id and secret from Dashboard > Account & Settings > API keys (use test keys until launch).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set on the webhook in Dashboard > Webhooks; separate from the key secret.
RAZORPAY_WEBHOOK_SECRET=

# Facebook Login for Business configuration id for Connect (Pages, Instagram, ads). Create it with the scopes in src/lib/meta-connect/scopes.ts.
# Add https://wa.edwyz.com/api/meta-connect/callback to Valid OAuth redirect URIs.
META_LOGIN_CONFIG_ID=

# Content calendar: HMAC secret for the short-lived public media URLs Meta fetches (falls back to STATE_SECRET when empty).
CONTENT_MEDIA_SECRET=

# Creative Studio: AI model comes from AI_MODEL/ANTHROPIC_API_KEY. CREATIVE_IMAGE_PROVIDER selects the image provider: placeholder,
# http (below) or brand (images with the business's logo, drawn by Studio; needs STUDIO_ENABLED=on). Unset means brand once
# Studio is on and placeholder while it is off. Any other value is a startup error.
CREATIVE_IMAGE_PROVIDER=placeholder
# HMAC secret for signed public creative asset URLs (falls back to STATE_SECRET when empty).
CREATIVE_MEDIA_SECRET=

# AI (assistant, AI reply bot, inbox suggestions, creative copy and Eddy). With no key every AI feature is off.
# In production give wa its own Anthropic key with a monthly spend limit set in the Anthropic console, and set
# EDDY_ANTHROPIC_KEY_DEDICATED=true below; check-env warns until then.
ANTHROPIC_API_KEY=
# Default Claude model for the AI agent and creative copy (empty = claude-sonnet-5-5).
AI_MODEL=

# AI agent cost guards (ai-mcp). Monthly credits for workspaces whose plan sets no AI credit limit (default 200, never unlimited).
AI_DEFAULT_MONTHLY_CREDITS=200
# Comma-separated Claude model ids a workspace may choose for its AI agent. Unset = only the default model (AI_MODEL).
AI_ALLOWED_MODELS=
# Workspace-wide cap on AI replies per hour (default 60).
AI_MAX_REPLIES_PER_HOUR=60

# Tenant MCP sending limits (ai-mcp). Confirmed sends per API key per hour and per contact per 24 hours.
MCP_MAX_SENDS_PER_KEY_HOUR=20
MCP_MAX_SENDS_PER_RECIPIENT_DAY=3
# HMAC secret for MCP confirm tokens (falls back to STATE_SECRET when empty; sending is refused if neither is set).
MCP_CONFIRM_SECRET=

# Optional guard for scripts/check-env.mjs and the startup report: number of web (not worker) instances you run. Must stay 1:
# replay guards, the live inbox connection count and the AI reply guard are kept per process (docs/ops.md section 2).
# WEB_INSTANCES=1

# Startup checks, logging and security headers (docs/ops.md sections 2, 4, 6 and 7).
# report-only (default) keeps the old policy enforced and only reports the strict nonce policy; set enforce once the report-only
# log shows only the expected violations (docs/ops.md section 6, rollout). Any other value is an error.
CSP_MODE=report-only
# 1 makes the app refuse to start while scripts/check-env.mjs finds errors. Leave it empty until that check passes on the server.
ENV_STRICT=
# debug, info, warn or error (default info).
LOG_LEVEL=info
# Where rate limit counts live: empty or settings (PlatformSetting rows shared by every process, the default) or memory (per process,
# reset on every restart; the default under NODE_ENV=test). table is refused until the RateLimitBucket migration exists.
RATELIMIT_BACKEND=

# Creative Studio HTTP image provider (CREATIVE_IMAGE_PROVIDER=http). Contract: docs/creative-image-provider.md. Both are required; the key is a secret.
CREATIVE_IMAGE_URL=
CREATIVE_IMAGE_KEY=

# Email verification gate (platform-saas). Unverified users can read and change settings but cannot send, import, create API keys or connect Meta.
# true or false forces it. When empty or unset the gate is on only if SMTP_USER is set (so a workspace is never stuck read-only because no mail can be sent).
EMAIL_VERIFICATION_REQUIRED=

# Worker daemon (pm2 app edwyz-wa-worker): milliseconds between polls when idle (default 2000, minimum 250).
WORKER_INTERVAL_MS=2000

# Spend controls rollout flags (docs/SPEND-CONTROLS-SPEC.md 4.14, docs/ops.md 15.1). The values below are the safe train 1 defaults;
# a typo is a startup error, never a silent fallback. Change them only with the preconditions in docs/ops.md section 15.
SPEND_ENFORCE=observe
SPEND_TRIPWIRE=report
SPEND_CAP_MODE=off
ASSISTANT_SPEND_ENABLED=false
# Staging and e2e only: no Meta writes (fake ids). Refused in production.
SPEND_DRY_RUN=
# Synthetic insights for sandbox ad accounts only.
SPEND_SIM=
# Signs the WhatsApp quick replies of owner spending notifications: 32+ random bytes, hex or base64 (openssl rand -hex 32).
SPEND_NOTIFY_SECRET=

# Eddy, the in-app helper (docs/EDDY-SPEC.md, docs/ops.md 15.1). Empty means the default named in brackets.
# The platform switch (false). Each workspace owner still turns Eddy on in Settings.
EDDY_ENABLED=false
# true only when ANTHROPIC_API_KEY is wa's own key with a monthly spend limit set in the Anthropic console (false).
EDDY_ANTHROPIC_KEY_DEDICATED=false
# 1 or 2; 2 allows spending actions, only after the Phase 0 gates (1).
EDDY_PHASE=
# claude-sonnet-5-5 or claude-opus-5-5; must also be on AI_ALLOWED_MODELS when that list is set (claude-sonnet-5-5).
EDDY_MODEL=
# low, medium, high, xhigh or max (low).
EDDY_EFFORT=
# Output tokens per round, 2000 to 128000 (8000).
EDDY_MAX_TOKENS=
# on or off: server-side fallback models on a refusal or overload (on).
EDDY_FALLBACKS=
# 5m or 1h: cache lifetime of each member's own history (5m).
EDDY_TAIL_CACHE_TTL=
# Credits: 1 credit = this many micro-USD (10000), per member per day (40), per turn (30), and turns streaming at once (40).
EDDY_MICROUSD_PER_CREDIT=
EDDY_MAX_CREDITS_PER_USER_DAY=
EDDY_MAX_CREDITS_PER_TURN=
EDDY_MAX_CONCURRENT_TURNS=
# JSON price override in USD per million tokens (empty = the table in src/lib/spend/exec/ai-pricing.ts).
EDDY_PRICES=
# on runs the optional injection screen before each turn (off).
EDDY_INJECTION_SCREEN=
# scripted replaces the model with scripted replies for e2e and staging. Refused in production.
EDDY_FAKE_MODEL=

# Android app (Trusted Web Activity, docs/PLAY-STORE.md). Both optional. /.well-known/assetlinks.json is served only when at least one
# valid fingerprint is set, and answers 404 otherwise. ANDROID_PACKAGE defaults to com.edwyz.wa.
# ANDROID_ASSETLINKS_SHA256: comma-separated SHA-256 signing certificate fingerprints, 32 colon-separated hex bytes each (AB:CD:...),
# for BOTH the upload key (keytool -list -v) and Google Play's app signing key (Play Console > Test and release > Setup > App signing).
ANDROID_PACKAGE=
ANDROID_ASSETLINKS_SHA256=

# Studio images, Canva and Meta's ads MCP (docs/specs/ADS-MCP-CANVA-CREATIVE-SPEC.md 5.8). Every switch stays off until the owner
# turns it on; a typo is a startup error, never a silent fallback. Empty means the default named in brackets.
# on shows Studio (branded images and the Library); off hides every Studio surface and /api/studio answers 404 (off).
STUDIO_ENABLED=off
# Saved Studio images per workspace per day, 10 to 5000 (100).
STUDIO_DAILY_RENDERS=
# Read by @napi-rs/canvas: draw images with the bundled fonts only. Keep it 1.
DISABLE_SYSTEM_FONTS_LOAD=1
# Canva Connect app from the Canva Developer Portal: set both or neither (empty keeps Canva off). The secret is a secret.
# Canva is on only when both are set and STUDIO_ENABLED=on.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# on allows MP4 imports from Canva. Keep off until the VPS disk is below 80% (off).
CANVA_VIDEO=off
# on turns on ad checks from Meta's ads MCP server (read only). Turn it on only after ads_mcp_management is in the app's use case
# and the Login for Business configuration, or every workspace sees a reconnect alert that reconnecting cannot fix (off).
META_ADS_MCP=off
# Ads MCP calls per workspace per day (cache misses only), 50 to 10000 (600).
META_ADS_MCP_DAILY_CALLS=
# on shows the owner's optional card that asks Meta to stop AI tools raising budgets on the spending ad account (off).
META_ADS_MCP_RULES=off
# Tests only, refused in production: loopback addresses of the fake Canva and ads MCP servers (e2e, ports 4592 and 4591).
CANVA_API_BASE_URL=
CANVA_AUTH_BASE_URL=
META_ADS_MCP_URL=
